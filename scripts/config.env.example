# chat-rk1 build configuration — copy to config.env and edit.
#
# These are the only machine/site-specific values in the build pipeline. The
# committed artifacts read them from the environment (with the defaults below)
# so nothing local is baked into the tree. `source scripts/config.env` before
# running any build script, or export them yourself.

# ---- Local build infrastructure ----------------------------------------------
# OCI registry the build pushes images to and the cluster pulls from. Use a
# LAN-reachable address:port (a bare "localhost:5000" works for a single-host
# build+run; the Talos nodes must be able to reach it to pull).
REGISTRY="${REGISTRY:-localhost:5000}"

# buildx builder name (created by 00-infra.sh) and the target platform.
BUILDER="${BUILDER:-talos-builder}"
PLATFORM="${PLATFORM:-linux/arm64}"

# ---- Kernel / module build ----------------------------------------------------
# Exact running kernel on the RK1 nodes. rocket.ko vermagic MUST match this or
# the module refuses to load. Confirm with: talosctl -n <node> read /proc/version
KVER="${KVER:-6.18.34-talos}"

# ---- Image tags (rarely need changing) ----------------------------------------
RUNTIME_IMAGE="${RUNTIME_IMAGE:-${REGISTRY}/rocket-runtime:latest}"
MODULE_IMAGE="${MODULE_IMAGE:-${REGISTRY}/rocket-module:${KVER}}"

# ---- Publishing to ghcr.io (scripts/30-push-ghcr.sh) ---------------------------
# GitHub owner (user or org) the public image lives under. The k8s manifests
# default to ghcr.io/OWNER/chat-rk1/rocket-runtime — replace OWNER there too.
GHCR_OWNER="${GHCR_OWNER:-OWNER}"
GHCR_IMAGE="${GHCR_IMAGE:-ghcr.io/${GHCR_OWNER}/chat-rk1/rocket-runtime}"
# Human release tag pinned by the manifests. A second immutable provenance tag
# (llamacpp-<short sha>) is derived from LLAMACPP_REF automatically.
RUNTIME_VERSION="${RUNTIME_VERSION:-v0.1.0}"

# ---- Upstream sources (pinned for reproducibility) -----------------------------
# Override to bump versions. Commits/tags are pinned in PROVENANCE.md.
ROCKET_USERSPACE_REPO="${ROCKET_USERSPACE_REPO:-https://github.com/gregordinary/rocket-userspace}"
ROCKET_USERSPACE_REF="${ROCKET_USERSPACE_REF:-e7bf520f16119556a6bbfffbb3859acf0cb15750}"
GGML_ROCKET_REPO="${GGML_ROCKET_REPO:-https://github.com/gregordinary/ggml-rocket}"
GGML_ROCKET_REF="${GGML_ROCKET_REF:-b3c7af2ec46ef4b46c06ee38d72734f6be46eee2}"
PATCHES_REPO="${PATCHES_REPO:-https://github.com/gregordinary/patches}"
PATCHES_REF="${PATCHES_REF:-a402fd101afad8bb1d5cfe2e99fc78e2bd35b940}"
# llama.cpp pinned to a commit contemporaneous with ggml-rocket's release
# (2026-07-06), so its vendored ggml is GGML_BACKEND_API_VERSION 2 / v0.14.0 —
# the ABI ggml-rocket targets. Bump only alongside a ggml-rocket that re-checks
# the backend vtable (see ggml-rocket API.md "ABI").
LLAMACPP_REPO="${LLAMACPP_REPO:-https://github.com/ggml-org/llama.cpp}"
LLAMACPP_REF="${LLAMACPP_REF:-ee445f93d8a0a5033a46d1960e901ef5caec9a41}"
